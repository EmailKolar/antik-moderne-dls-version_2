// Combined Prisma schema for mock-backend
// You can add more models as needed for your demo

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Float
  imageUrl  String?
  stock     Int
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Basket {
  id        String   @id @default(uuid())
  userId    String
  items     BasketItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BasketItem {
  id        String   @id @default(uuid())
  basketId  String
  basket    Basket   @relation(fields: [basketId], references: [id])
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
